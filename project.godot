; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by text editors.

config_version=5

[application]

config/name="SurvivorQuest"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Loc="*res://scripts/loc.gd"
AdManager="*res://scripts/ad_manager.gd"
GameManager="*res://scripts/game_manager.gd"
SoundManager="*res://scripts/sound_manager.gd"
FloatingText="*res://scripts/floating_text.gd"
LeaderboardManager="*res://scripts/leaderboard_manager.gd"
CodexManager="*res://scripts/codex_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

